        "order": 2,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "ui_group_table",
        "type": "ui_group",
        "name": "최근 측정 기록",
        "tab": "ui_tab_dashboard",
        "order": 3,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "db_config",
        "type": "MySQLdatabase",
        "name": "env_monitor",
        "host": "127.0.0.1",
        "port": "3306",
        "db": "env_monitor",
        "inCharset": "utf8",
        "outCharset": "utf8",
        "tz": "",
        "user": "env_user",
        "password": "env_pass123",
        "connectTimeout": "10000",
        "queryTimeout": "4000"
    },

    {
        "id": "inject_trigger",
        "type": "inject",
        "z": "tab_main",
        "name": "3초마다 실행",
        "props": [{"p": "payload"}],
        "repeat": "3",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 120,
        "y": 100,
        "wires": [["set_query_latest", "set_query_history"]]
    },

    {
        "id": "set_query_latest",
        "type": "function",
        "z": "tab_main",
        "name": "쿼리: 최신값",
        "func": "msg.topic = \"SELECT location, ROUND(temperature,1) as temperature, ROUND(humidity,1) as humidity, co2, ROUND(pm25,1) as pm25 FROM sensor_data WHERE (location, recorded_at) IN (SELECT location, MAX(recorded_at) FROM sensor_data GROUP BY location) ORDER BY FIELD(location,'실험실','사무실','서버실','야외');\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 320,
        "y": 60,
        "wires": [["mysql_latest"]]
    },
    {
        "id": "mysql_latest",
        "type": "mysql",
        "z": "tab_main",
        "mydb": "db_config",
        "name": "MySQL: 최신값",
        "x": 520,
        "y": 60,
        "wires": [["parse_gauges", "parse_charts"]]
    },

    {
        "id": "set_query_history",
        "type": "function",
        "z": "tab_main",
        "name": "쿼리: 최근기록",
        "func": "msg.topic = \"SELECT recorded_at, location, ROUND(temperature,1) as temperature, ROUND(humidity,1) as humidity, co2, ROUND(pm25,1) as pm25 FROM sensor_data ORDER BY recorded_at DESC LIMIT 20;\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 320,
        "y": 140,
        "wires": [["mysql_history"]]
    },
    {
        "id": "mysql_history",
        "type": "mysql",
        "z": "tab_main",
        "mydb": "db_config",
        "name": "MySQL: 최근기록",
        "x": 520,
        "y": 140,
        "wires": [["parse_table"]]
    },

    {
        "id": "parse_gauges",
        "type": "function",
        "z": "tab_main",
        "name": "게이지 분배",
        "func": "var rows = msg.payload;\nif (!rows || rows.length === 0) return null;\nvar totT=0, totH=0, totC=0, totP=0;\nrows.forEach(function(r){\n    totT += parseFloat(r.temperature);\n    totH += parseFloat(r.humidity);\n    totC += parseInt(r.co2);\n    totP += parseFloat(r.pm25);\n});\nvar n = rows.length;\nvar mT = {payload: Math.round(totT/n*10)/10, topic:'평균온도'};\nvar mH = {payload: Math.round(totH/n*10)/10, topic:'평균습도'};\nvar mC = {payload: Math.round(totC/n),       topic:'평균CO2'};\nvar mP = {payload: Math.round(totP/n*10)/10, topic:'평균PM25'};\nreturn [mT, mH, mC, mP];",
        "outputs": 4,
        "noerr": 0,
        "x": 740,
        "y": 20,
        "wires": [
            ["gauge_temp"],
            ["gauge_hum"],
            ["gauge_co2"],
            ["gauge_pm"]
        ]
    },

    {
        "id": "parse_charts",
        "type": "function",
        "z": "tab_main",
        "name": "차트 분배",
        "func": "var rows = msg.payload;\nif (!rows || rows.length === 0) return [null,null,null,null];\nvar now = Date.now();\nvar msgsT=[], msgsH=[], msgsC=[], msgsP=[];\nrows.forEach(function(r){\n    msgsT.push({payload: parseFloat(r.temperature), topic: r.location, x: now});\n    msgsH.push({payload: parseFloat(r.humidity),    topic: r.location, x: now});\n    msgsC.push({payload: parseInt(r.co2),           topic: r.location, x: now});\n    msgsP.push({payload: parseFloat(r.pm25),        topic: r.location, x: now});\n});\nreturn [msgsT, msgsH, msgsC, msgsP];",
        "outputs": 4,
        "noerr": 0,
        "x": 740,
        "y": 80,
        "wires": [
            ["chart_temp"],
            ["chart_hum"],
            ["chart_co2"],
            ["chart_pm"]
        ]
    },

    {
        "id": "parse_table",
        "type": "function",
        "z": "tab_main",
        "name": "테이블 HTML",
        "func": "var rows = msg.payload;\nif (!rows) { msg.payload='<p>데이터 없음</p>'; return msg; }\nvar html = '<div style=\"overflow-x:auto\"><table style=\"width:100%;border-collapse:collapse;font-size:13px;font-family:sans-serif\">';\nhtml += '<thead><tr style=\"background:#1565c0;color:#fff;text-align:center\">';\nhtml += '<th style=\"padding:8px\">시각</th><th>위치</th><th>온도(°C)</th><th>습도(%)</th><th>CO₂(ppm)</th><th>PM2.5</th></tr></thead><tbody>';\nrows.forEach(function(r,i){\n    var bg=(i%2===0)?'#fff':'#f0f4ff';\n    var dt=new Date(r.recorded_at);\n    var ts=('0'+dt.getHours()).slice(-2)+':'+('0'+dt.getMinutes()).slice(-2)+':'+('0'+dt.getSeconds()).slice(-2);\n    var tColor = r.temperature>30?'red':(r.temperature>26?'orange':'inherit');\n    var cColor = r.co2>1000?'red':(r.co2>800?'orange':'inherit');\n    html+='<tr style=\"background:'+bg+';text-align:center\">';\n    html+='<td style=\"padding:5px\">'+ts+'</td>';\n    html+='<td><b>'+r.location+'</b></td>';\n    html+='<td style=\"color:'+tColor+'\">'+r.temperature+'</td>';\n    html+='<td>'+r.humidity+'</td>';\n    html+='<td style=\"color:'+cColor+'\">'+r.co2+'</td>';\n    html+='<td>'+r.pm25+'</td>';\n    html+='</tr>';\n});\nhtml+='</tbody></table></div>';\nmsg.payload=html;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 740,
        "y": 140,
        "wires": [["ui_table"]]
    },

