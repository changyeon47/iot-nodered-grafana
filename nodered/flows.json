        "disabled": false,
        "hidden": false
    },
    {
        "id": "ui_group_overview",
        "type": "ui_group",
        "name": "실시간 센서 현황",
        "tab": "ui_tab_dashboard",
        "order": 1,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "ui_group_charts",
        "type": "ui_group",
        "name": "시계열 차트",
